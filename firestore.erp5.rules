rules_version = '2';

// ERP5는 개인정보·계약·상담을 저장하지 않는 상품 조회 전용 Firestore다.
// 쓰기는 이 저장소의 버전 발행기(Admin SDK)만 수행하며 클라이언트 쓰기는 전면 금지한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isCatalogueReader() {
      return signedIn() && (
        request.auth.token.role == 'admin'
        || request.auth.token.role == 'agent'
        || request.auth.token.role == 'whitelabel'
      );
    }

    function isActiveProductVersion(versionId) {
      return exists(/databases/$(database)/documents/ssotState/products)
        && get(/databases/$(database)/documents/ssotState/products).data.activeVersionId == versionId;
    }

    function isActiveVehicleVersion(versionId) {
      return exists(/databases/$(database)/documents/ssotState/vehicleMaster)
        && get(/databases/$(database)/documents/ssotState/vehicleMaster).data.activeVersionId == versionId;
    }

    // 세 역할은 현재 활성 버전 포인터만 읽는다. 교체는 발행기만 한다.
    match /ssotState/{name} {
      allow read: if isCatalogueReader() && (name == 'products' || name == 'vehicleMaster');
      allow write: if false;
    }

    // 관리자는 검증본까지 볼 수 있고, 영업자·화이트라벨은 활성 상품 버전만 본다.
    match /productMasterVersions/{versionId} {
      allow read: if isAdmin() || (isCatalogueReader() && isActiveProductVersion(versionId));
      allow write: if false;

      match /products/{productId} {
        allow read: if isAdmin() || (isCatalogueReader() && isActiveProductVersion(versionId));
        allow write: if false;
      }
    }

    // 차종마스터도 같은 활성 버전 경계를 쓴다.
    match /vehicleMasterVersions/{versionId} {
      allow read: if isAdmin() || (isCatalogueReader() && isActiveVehicleVersion(versionId));
      allow write: if false;

      match /entries/{entryId} {
        allow read: if isAdmin() || (isCatalogueReader() && isActiveVehicleVersion(versionId));
        allow write: if false;
      }
    }

    // ERP5에는 위 공개 SSOT 외의 클라이언트 접근면을 만들지 않는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
