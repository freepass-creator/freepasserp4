        "^dependabot/",
        "^renovate/"
      ],
      "forbidden_actor_prefixes": [
        "gpt/",
        "claude/",
        "codex/",
        "cursor/",
        "gemini/",
        "chatgpt/",
        "work/gpt/",
        "work/claude/",
        "work/codex/",
        "work/cursor/",
        "work/gemini/"
