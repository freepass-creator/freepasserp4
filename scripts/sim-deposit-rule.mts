/**
 * **보증금 규칙 글자 → 금액, 셈이 맞나.** 읽기 전용 · 어긋나면 종료코드 1.
 *
 * ★★★사장님 2026-09-18 「화이트라벨에는 실제로 그 보증금을 입력해 두자 · 계산해서 넣어 주자」.
 *
 * ⚠⚠ **이 숫자는 영업자가 손님에게 «불러 주는 값»이다.** 한 자리만 틀려도 잘못된 약속이 된다.
 *   그래서 셈법(`lib/format.ts` `depositFromRule`)을 글로만 두지 않고 **여기서 매번 다시 푼다.**
 * ★기대값은 **운영 실측 대여료**로 짰다(2026-09-18 · 687대 전수에서 규칙 글자는 다섯 가지뿐).
 *   셈법은 수집기가 쓰던 그 공식 그대로다 — 새로 지은 것이 아니다(`depositFromRule` 머리말 표).
 * ★★**제일 중요한 줄은 「모르면 null」**이다. 새 공급사가 새 규칙 글자를 들고 왔을 때
 *   조용히 «틀린 금액»을 부르지 않고 규칙 글자를 그대로 보여 주는지를 지킨다.
 */
import { depositFromRule } from '../lib/format';
const cases: Array<[string, number, number, number | null, string]> = [
  ['월 대여료 × 약정연수 (최대 3개월)', 1262000, 12, 1262000, '12개월 → 1년치'],
  ['월 대여료 × 약정연수 (최대 3개월)', 994000, 24, 1988000, '24개월 → 2년치'],
  ['월 대여료 × 약정연수 (최대 3개월)', 870000, 36, 2610000, '36개월 → 3년치'],
  ['월 대여료 × 약정연수 (최대 3개월)', 809000, 48, 2427000, '48개월 → 캡 3'],
  ['월 대여료 × 약정연수 (최대 3개월)', 773000, 60, 2319000, '60개월 → 캡 3'],
  ['국산: 월 대여료×2', 770000, 12, 1540000, '국산 ×2'],
  ['국산: 월 대여료×2', 730000, 36, 1460000, '국산 ×2 (기간 무관)'],
  ['수입: 12개월 대여료×3 · 18개월↑ ×6', 850000, 12, 2550000, '수입 12개월 ×3'],
  ['수입: 12개월 대여료×3 · 18개월↑ ×6', 790000, 18, 4740000, '수입 18개월 ×6'],
  ['수입: 12개월 대여료×3 · 18개월↑ ×6', 710000, 24, 4260000, '수입 24개월 ×6'],
  ['무보증', 650000, 36, null, '무보증은 안 센다(부르는 쪽이 「없음」)'],
  ['', 650000, 36, null, '빈칸'],
  ['공급사가 새로 쓴 모르는 규칙', 650000, 36, null, '★모르면 null — 지어내지 않는다'],
  ['월 대여료 × 약정연수 (최대 2개월)', 1000000, 60, 2000000, '캡을 글자에서 읽는다'],
];
let bad = 0;
for (const [note, rent, months, want, why] of cases) {
  const got = depositFromRule(note, rent, months);
  const ok = got === want;
  if (!ok) bad++;
  console.log(`   ${ok ? '·' : '✗'} ${why.padEnd(28)} ${String(got).padStart(9)}  (기대 ${want})`);
}
console.log(bad ? `\n✗ ${bad}건 어긋남\n` : '\n✓ 보증금 셈법 전부 일치\n');
process.exit(bad ? 1 : 0);
