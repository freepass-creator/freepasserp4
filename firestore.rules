rules_version = '2';
// [초안] 회사·역할 격리 — 프리패스erp v1~v3 반복된 최대 약점(Rules 미배포, 클라이언트 필터 의존) 해소용.
// 권한 SSOT: user/{uid} 운영 프로필. Auth 커스텀클레임과 이중 관리하지 않는다.
// 원칙: 로그인+같은 회사만 read. 하드삭제 전면 금지(소프트삭제 _deleted만). 정산 금액은 관리자만. 감사로그 append-only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/user/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/user/$(request.auth.uid)); }
    function active() { return hasProfile()
      && me().status != 'pending' && me().status != 'deleted' && me().status != 'rejected'
      && me().is_active != '아니오' && me().is_active != false; }
    function role() { return me().role; }
    function myCompany(doc) { return active() && doc.companyId == me().company_code; }
    function isAdmin() { return active() && role() == 'admin'; }
    function isProvider() { return active() && (role() == 'provider' || role() == 'provider_admin'); }
    function isAgent() { return active() && (role() == 'agent' || role() == 'agent_admin' || role() == 'agent_manager'); }

    // 매물 — 관리자 전체, 공급사는 자기 회사 매물만 write
    match /product/{id} {
      allow read: if signedIn() && myCompany(resource.data);
      allow create, update: if isAdmin()
        || (isProvider() && myCompany(request.resource.data) && request.resource.data.provider_company_code == me().company_code);
      allow delete: if false;
    }
    // 파인더 카탈로그(차번별 원자) — 파는 차 목록은 마켓이라 로그인 전원 read.
    //   원가·수수료·차대번호·계좌는 담지 않는다(미러가 걷어냄) → 노출 안전.
    //   쓰기는 서버(미러/동기, admin SDK — 규칙 우회)만. 클라 쓰기 전면 금지.
    match /products/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isProvider()
          && request.resource.data.provider_company_code == me().company_code);
      allow update: if isAdmin()
        || (isProvider()
          && resource.data.provider_company_code == me().company_code
          && request.resource.data.provider_company_code == me().company_code);
      allow delete: if false;
    }
    // 계약 — 관리자 전체 · 공급사=자기 공급사코드 · 영업자=자기 계약(agent_code=user_code).
    //   ★2026-09-04: companyId(계약)=공급사코드 base 라 myCompany(companyId==company) 는 영업자(company=SP999)에 안 맞는다.
    //     격리는 provider_company_code / agent_code 로 «직접». (실측: 계약 agent_code = user_code)
    match /contract/{id} {
      allow read: if signedIn() && (isAdmin()
        || (isProvider() && resource.data.provider_company_code == me().company_code)
        || (isAgent() && resource.data.agent_code == me().user_code));
      allow create, update: if signedIn() && (isAdmin()
        || (isAgent() && request.resource.data.agent_code == me().user_code)
        || (isProvider() && request.resource.data.provider_company_code == me().company_code));
      allow delete: if false;
    }
    // 정산 — read 는 자기 공급사/자기 계약 · 금액 변경(create/update)은 관리자만(공급사 임의 상향 방지).
    match /settlement/{id} {
      allow read: if signedIn() && (isAdmin()
        || (isProvider() && resource.data.provider_company_code == me().company_code)
        || (isAgent() && resource.data.agent_code == me().user_code));
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    // 감사로그 — append-only, 수정·삭제 금지. ★컬렉션명 audit_logs(복수) — 미러·이관·어댑터와 일치(전엔 audit_log 단수라 쓰기 거부됐다).
    match /audit_logs/{id} {
      allow read: if isAdmin() && myCompany(resource.data);
      allow create: if signedIn() && myCompany(request.resource.data);
      allow update, delete: if false;
    }
    // 정책·공급사·사용자 — 관리자만 write, 같은 회사 read
    // ★정책·파트너 = 참조데이터 — 영업자가 «어느 공급사» 정책·정보든 봐야 팔 수 있다(products 처럼 로그인이면 read).
    //   companyId=공급사코드라 myCompany 로 묶으면 영업자(company=SP999)가 못 읽는다(2026-09-04). 쓰기는 관리자만.
    match /{col}/{id} {
      allow read: if signedIn() && (col == 'policy' || col == 'partner');
      allow create, update: if isAdmin() && (col == 'policy' || col == 'partner');
      allow delete: if false;
    }
    // 사용자 명부 — 관리자 전체 + «자기 프로필»은 본인 read(문서 id=uid). 로그인 게이트가 자기 프로필을 읽어야 한다(RTDB 폐기).
    //   ★쓰기는 관리자만(가입·승인은 서버 API 가 admin SDK 로 — 규칙 우회).
    match /user/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow create: if isAdmin() || (signedIn()
        && request.auth.uid == id
        && request.resource.data.uid == id
        && request.resource.data.role == 'agent'
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'company_name', 'business_no', 'user_code',
          'requested_type', 'status', 'role', 'created_at', 'email',
          'terms_agreed_at', 'privacy_agreed_at', 'legal_version'
        ]));
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'company_name', 'terms_agreed_at',
          'privacy_agreed_at', 'legal_version'
        ]));
      allow delete: if false;
    }
    match /users_private/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow create: if isAdmin() || (signedIn()
        && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['email']));
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']));
      allow delete: if false;
    }
    match /partners_private/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /_client_errors/{id} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    // 공개 링크는 192-bit 토큰 문서의 단건 get만 허용한다. 익명 제출은
    // 발송→검토대기 전이와 서명 입력 필드만 바꿀 수 있다.
    match /contract_sign/{token} {
      allow get: if (resource.data.status == 'sent'
          && (!('revoked_at' in resource.data) || resource.data.revoked_at == null)
          && (!('sign_revoked_at' in resource.data) || resource.data.sign_revoked_at == null)
          && (!('expires_at' in resource.data) || resource.data.expires_at == null || resource.data.expires_at > request.time.toMillis()))
        || isAdmin()
        || (isAgent() && (resource.data.agent_uid == request.auth.uid
          || ((role() == 'agent_admin' || role() == 'agent_manager')
            && resource.data.agent_channel_code == me().agent_channel_code)));
      allow list: if false;
      allow create: if isAdmin()
        || (isAgent() && request.resource.data.agent_uid == request.auth.uid);
      allow update: if isAdmin()
        || (isAgent()
          && request.resource.data.agent_uid == resource.data.agent_uid
          && (resource.data.agent_uid == request.auth.uid
            || ((role() == 'agent_admin' || role() == 'agent_manager')
              && resource.data.agent_channel_code == me().agent_channel_code)));
      allow update: if resource.data.status == 'sent'
        && (!('revoked_at' in resource.data) || resource.data.revoked_at == null)
        && (!('sign_revoked_at' in resource.data) || resource.data.sign_revoked_at == null)
        && (!('expires_at' in resource.data) || resource.data.expires_at == null || resource.data.expires_at > request.time.toMillis())
        && request.resource.data.status == 'pending_review'
        && request.resource.data.sign_consents == 'rental_terms,privacy,credit,gps,cms'
        && request.resource.data.sign_consent_version == 'v1'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customer_name', 'customer_phone', 'customer_id', 'customer_address',
          'driver_license_no', 'emergency_name', 'emergency_phone',
          'sign_signature', 'sign_consents', 'sign_consent_version',
          'sign_status', 'sign_signed_at', 'status', 'updated_at', 'sign_token'
        ]);
      allow delete: if false;
    }
    // 방·메시지·견적·고객 — 로그인 + 같은 회사면 write(거래 참여자)
    // 손님(개인정보) — companyId=PT-0000 공유라 myCompany 로는 못 가른다. «만든 사람(created_by=uid)»만 본다(2026-09-04).
    match /customer/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.created_by == request.auth.uid);
      allow create: if signedIn() && request.resource.data.created_by == request.auth.uid;
      allow update: if signedIn() && (isAdmin() || resource.data.created_by == request.auth.uid);
      allow delete: if false;
    }
    match /{col}/{id} {
      allow read: if signedIn() && myCompany(resource.data) && (col == 'room' || col == 'message' || col == 'quote');
      allow create, update: if signedIn() && myCompany(request.resource.data) && (col == 'room' || col == 'message' || col == 'quote');
      allow delete: if false;
    }
  }
}
