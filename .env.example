# Firebase — freepasserp3 프로젝트 공유(회원·v3 실데이터 읽기).
# 비우면 LocalAdapter(localStorage) + seed 미리보기.
# 실데이터: API 키 채우고 NEXT_PUBLIC_DATA_BACKEND=rtdb
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=freepasserp3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://freepasserp3-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=freepasserp3
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=freepasserp3.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=172664197996
NEXT_PUBLIC_FIREBASE_APP_ID=

# rtdb = v3 라이브 읽기 + 쓰기는 v4/ 오버레이만 (v3 원본 무변경)
# firestore = v4 Firestore (미사용 시 비움)
# 비움/기타 = Local + seed
NEXT_PUBLIC_DATA_BACKEND=rtdb

# 공개 약관·개인정보처리방침 운영자 정보. 사실값을 확인해 Vercel Production/Preview에 동일하게 입력한다.
# 값은 공개 번들에 포함되며 변경 후 재배포가 필요하다. 대표전화만 선택, 나머지는 출시 필수다.
NEXT_PUBLIC_OPERATOR_COMPANY=
NEXT_PUBLIC_OPERATOR_CEO=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_BIZ_NO=
NEXT_PUBLIC_OPERATOR_EMAIL=
NEXT_PUBLIC_OPERATOR_PHONE=
NEXT_PUBLIC_OPERATOR_PRIVACY_OFFICER=

# 선택 기능: 상품 사진·계약 서류를 Google Drive에 2차 백업.
# 네 값이 모두 있어야 활성화되며, 비어 있으면 Firebase Storage만 사용한다.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# 매일 02:00 KST Google Sheet → v4/products 재고 동기화.
# 실제 데이터 dry-run과 사람/Claude 검토 전에는 false로 유지한다.
SHEET_DAILY_SYNC_ENABLED=false
SHEET_SYNC_COMPANY_ID=freepass
CRON_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# 차량 이중판매 원자 선점. 서비스계정 + 후보 Rules + Preview 역할 smoke가 모두 끝난 배포에서만 둘 다 true.
# 서버 플래그가 1차 kill switch이며, NEXT_PUBLIC_ 플래그는 검증된 클라이언트 경로를 켠다.
VEHICLE_CLAIM_SERVER_ENABLED=false
NEXT_PUBLIC_ATOMIC_VEHICLE_CLAIMS=false

# 착한거래 전자계약 서버 연동. 네 값이 모두 있어야 계약 화면의 발송 버튼이 실제 외부 발송한다.
# API 키는 NEXT_PUBLIC_ 접두사를 붙이지 않는다(브라우저 노출 금지).
# 예: https://service.example.com (origin만, /api 경로 입력 금지)
CHAKHANDEAL_API_BASE_URL=
CHAKHANDEAL_API_KEY=
CHAKHANDEAL_MEMBER_COMPANY=freepass
CHAKHANDEAL_TEMPLATE_ID=
