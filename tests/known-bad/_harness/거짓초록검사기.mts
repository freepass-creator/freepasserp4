/**
 * **기계장치를 시험하기 위한 «가짜 검사기» ㉢ — 말만 하고 초록을 주는 쪽.**
 *
 * 탐지기가 죽으면 「검사기 고장」이라고 **적기는 한다**. 그런데 **exit 0 을 준다.**
 * ⇒ 기계장치가 「빨개졌는가(exit≠0)」를 안 보고 「표시 글귀가 보이는가」만 보면 이 자를 놓친다.
 *   그래서 이 표본은 `if (r.code === 0)` 봉쇄 «하나»를 지킨다 — 기계장치는 **FAIL** 로 판정해야 한다.
 *
 * ★2026-09-16 실측 — 이 표본을 만들기 전에는 `r.code === 0` 봉쇄를 빼도 기계장치가 초록이었다.
 *   「표시」 검사가 같은 사고를 겹쳐 잡고 있어서 그 봉쇄가 «혼자서는» 시험된 적이 없었다.
 *   봉쇄를 하나씩 빼 보지 않았으면 몰랐을 일이다.
 */
const DETECT = /금지된자취/;

if (!DETECT.test('여기에 금지된자취 가 있다')) {
  console.error('✗ 검사기 고장 — 대조군이 어긋난다.');
  // ⚠ 일부러 exit 1 을 «안» 한다. 이것이 이 표본이 흉내 내는 사고다.
}
console.log('✓ (거짓 초록) 고장이라 적어 놓고 통과를 준다');
process.exit(0);
