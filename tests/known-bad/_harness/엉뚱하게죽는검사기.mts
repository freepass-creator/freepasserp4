/**
 * **기계장치를 시험하기 위한 «가짜 검사기» ㉣ — 엉뚱한 봉쇄에 먼저 걸리는 쪽.**
 *
 * 탐지기가 죽으면 빨개지기는 한다. 그런데 **빨개진 이유가 대조군이 아니다** —
 * 그 전에 다른 자리에서 죽는다. 표본은 시험된 적이 없는데 빨간불이 그것을 가린다.
 *
 * ★★PR #38 의 교훈 그대로다(2026-09-16):
 *   · 링크 검사는 **엉뚱한 봉쇄에 먼저 걸려** 통과했다 — 시험된 적이 없었다
 *   · head 검사는 **같은 에러 코드** 때문에 「원장 전에 막았다」와 구별이 안 됐다
 *   ⇒ 빨간불은 «이유»까지 대야 증거가 된다.
 *
 * ⇒ 기계장치는 이 자를 **FAIL** 로 판정해야 한다(「표시」 봉쇄가 지키는 자리).
 */
const DETECT = /금지된자취/;

if (!DETECT.test('여기에 금지된자취 가 있다')) {
  // 대조군이 어긋났지만, 그 말을 하기 «전에» 엉뚱한 곳에서 먼저 죽는다.
  console.error('✗ 설정 파일을 못 읽었다 — ENOENT tmp/어딘가.json');
  process.exit(1);
}
console.log('✓ 엉뚱하게 죽는 검사기 — 지금은 초록');
process.exit(0);
