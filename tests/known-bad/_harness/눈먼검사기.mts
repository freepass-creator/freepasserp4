/**
 * **기계장치를 시험하기 위한 «가짜 검사기» ㉡ — 눈먼 쪽.**
 *
 * 「초록불이 거짓말하는」 바로 그 모습이다 — 탐지기를 통째로 무력화해도 초록을 준다.
 * ★2026-09-16 실측으로 여럿 나온 무늬다: 표본이 «있는» 것과 표본이 그 봉쇄를 «시험하는» 것은 다르다.
 * ⇒ 기계장치는 이 자를 **FAIL** 로 판정해야 한다. PASS 로 판정하면 기계장치 자신이 눈먼 것이다.
 */
const DETECT = /금지된자취/;

// ⚠ 일부러 «쓰지 않는다» — 대조군이 없으므로 DETECT 가 죽어도 아무 일도 안 일어난다.
void DETECT;

console.log('✓ (거짓 초록) 아무것도 안 봤지만 통과라고 말한다');
process.exit(0);
